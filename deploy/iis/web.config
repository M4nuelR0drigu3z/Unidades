<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proxy inverso de IIS para la API de telemetria (ver docs/api-telemetria.md).
  Requiere: URL Rewrite, Application Request Routing (con "Enable proxy") y el rol
  "Restricciones de IP y dominio" para el bloque dynamicIpSecurity.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Telemetria - HTTPS obligatorio" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Solo se publica /telemetria/*; /salud y cualquier otra ruta quedan internas. -->
        <rule name="Telemetria - API" stopProcessing="true">
          <match url="^telemetria/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8010/telemetria/{R:1}" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Telemetria - HSTS">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <action type="Rewrite" value="max-age=31536000" />
        </rule>
      </outboundRules>
    </rewrite>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="1024" maxQueryString="256" maxUrl="512" />
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
        </verbs>
      </requestFiltering>
      <!-- Por IP: maximo 60 peticiones por minuto y 10 simultaneas. -->
      <dynamicIpSecurity denyAction="Forbidden">
        <denyByRequestRate enabled="true" maxRequests="60" requestIntervalInMilliseconds="60000" />
        <denyByConcurrentRequests enabled="true" maxConcurrentRequests="10" />
      </dynamicIpSecurity>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
