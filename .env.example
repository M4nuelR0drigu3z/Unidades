LOGITRACK_ACCESS_TOKEN=
LOGITRACK_TIMEOUT_SECONDS=60

# API de telemetria (api_telemetria.py)
# Una clave por consumidor: nombre:clave separados por coma
TELEMETRIA_API_KEYS=
TELEMETRIA_HOST=127.0.0.1
TELEMETRIA_PUERTO=8010
TELEMETRIA_CENTROS=TODOS
# Ciclos alineados al reloj (12:00, 12:03 ... 12:30); debe dividir 1800
TELEMETRIA_REFRESCO_SEGUNDOS=180
TELEMETRIA_HILOS_REFRESCO=4
TELEMETRIA_CACHE_SEGUNDOS=300
# Catalogo de unidades de TMWSuite (usa las variables SQL_* de arriba)
TELEMETRIA_CACHE_UNIDADES_SEGUNDOS=600
