# Logitrack
LOGITRACK_API_URL=https://api.logitrack.mx/api/v2
LOGITRACK_TOKEN_URL=https://api.logitrack.mx/api/v2/oauth/access_token
LOGITRACK_USERNAME=
LOGITRACK_PASSWORD=
LOGITRACK_CLIENT_ID=
